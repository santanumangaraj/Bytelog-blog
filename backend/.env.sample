NODE_ENV=development
PORT = your port num
TRUST_PROXY=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=bytelog

CORS_ORIGIN=http://localhost:5173

AWS_REGION = ap-region-number
AWS_ACCESS_KEY_ID= your access key id
AWS_SCERET_ACCESS_KEY= your seceret access key id
AWS_BUCKET_NAME = ur bucket name
REDIS_URL = ur redis url

# Auth tokens — MUST be two different long random secrets, never reuse the same value
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRY=7d

# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000

# Password reset email (SMTP via nodemailer) — optional at boot, but
# /forgot-password will fail until these are set
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=ByteLog <no-reply@example.com>
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_MS=1800000

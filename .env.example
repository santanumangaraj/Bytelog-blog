# Read by `docker compose` itself (not by the app) — needed to resolve the
# ${DB_PASS} / ${DB_NAME} / ${DOMAIN} references in docker-compose.yml
# BEFORE containers start. Copy this to a root-level `.env` alongside
# docker-compose.yml with real values.
#
# DB_PASS and DB_NAME must match backend/.env exactly — the mysql
# container is created with these, and the app connects to it using the
# same values from backend/.env. Two files, same values; docker-compose's
# variable substitution and each service's env_file are separate
# mechanisms that don't share one source automatically.

DB_PASS=same-value-as-backend/.env-DB_PASS
DB_NAME=same-value-as-backend/.env-DB_NAME

# Your domain, pointed at this VM's public IP via an A record.
DOMAIN=your-api-domain.com

# Local dev: point straight at your local backend.
VITE_API_URL=http://localhost:8002/api/v2

# Production (Vercel): set this to a RELATIVE path instead — "/api/v2" —
# not the full Render URL. vercel.json rewrites /api/v2/* to the Render
# backend server-side, so the browser only ever talks to your Vercel
# domain. That makes the auth cookies first-party (same-origin) instead of
# cross-site, which avoids browsers blocking them as third-party cookies —
# the actual root cause if login keeps bouncing back to /login after a
# successful sign-in. Must be set in Vercel's dashboard env vars (build-time,
# not just backend/.env) and requires a rebuild to take effect, not just a
# redeploy of an old build.

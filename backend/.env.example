# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8002

# Set to "true" only when running behind a real reverse proxy/load balancer
# (affects secure-cookie behavior and rate-limiter IP detection).
TRUST_PROXY=false

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=bytelog

# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:5173

# --- AWS S3 (avatar + blog cover image storage) ---
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket-name

# --- Redis (BullMQ queues + like-count cache + rate limiting) ---
# Set IS_DOCKER=true when running via docker-compose (it uses REDIS_URL_DOCKER instead).
IS_DOCKER=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_URL_DOCKER=redis://redis:6379

# --- Auth tokens ---
# MUST be two different long random secrets — generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRY=7d

# --- Account lockout ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000
